# Copy to .env. Every value is optional in development.
PORT=3000
NODE_ENV=development

# Required when NODE_ENV=production. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_DAYS=30

# Default: backend/data/verdant.db
DATABASE_PATH=

# Comma-separated browser origins allowed in production.
CORS_ORIGINS=

# Leave empty to disable email. Example: smtp://user:password@smtp.example.com:587
SMTP_URL=
MAIL_FROM=Verdant <no-reply@example.com>
